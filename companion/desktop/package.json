{
  "name": "auctionlens-sync-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AuctionLens Sync: the guild companion as a portable Windows exe with a tray icon.",
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && electron app",
    "smoke": "node build.js && electron app --smoke",
    "dist": "node build.js && electron-builder --config builder.json --win portable --x64",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.1",
    "esbuild": "^0.25.0"
  }
}
